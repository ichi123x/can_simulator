; Startup verification configuration (feature 002, quickstart.md steps 1-3).
; Six nodes power on 10 ms apart; every node sends one 100 ms frame so the bus
; is idle most of the time and the sync times are easy to check by hand.
; At 500 kbps one bit time is 2 us, so 11 recessive bit times = 22 us and the
; expected Normal_Entry_us values are 22 / 10022 / 20022 / 30022 / 40022 / 50022.

[Project]
EcuCount=6
DurationSec=10
FrameDisplay=0

[Network]
BitRateBps=500000

[Node1]
NodeId=1
Name=ECU1 Engine Control
PowerOnTimeUs=0
InitDurationUs=0

[Node1.Frame1]
CanId=0x100
Dlc=8
PeriodUs=100000
InitialOffsetUs=0

[Node2]
NodeId=2
Name=ECU2 Transmission
PowerOnTimeUs=10000
InitDurationUs=0

[Node2.Frame1]
CanId=0x120
Dlc=8
PeriodUs=100000
InitialOffsetUs=0

[Node3]
NodeId=3
Name=ECU3 ABS/Brake
PowerOnTimeUs=20000
InitDurationUs=0

[Node3.Frame1]
CanId=0x140
Dlc=8
PeriodUs=100000
InitialOffsetUs=0

[Node4]
NodeId=4
Name=ECU4 Body Control
PowerOnTimeUs=30000
InitDurationUs=0

[Node4.Frame1]
CanId=0x160
Dlc=8
PeriodUs=100000
InitialOffsetUs=0

[Node5]
NodeId=5
Name=ECU5 Meter Cluster
PowerOnTimeUs=40000
InitDurationUs=0

[Node5.Frame1]
CanId=0x180
Dlc=8
PeriodUs=100000
InitialOffsetUs=0

[Node6]
NodeId=6
Name=ECU6 Airbag
PowerOnTimeUs=50000
InitDurationUs=0

[Node6.Frame1]
CanId=0x1A0
Dlc=8
PeriodUs=100000
InitialOffsetUs=0
