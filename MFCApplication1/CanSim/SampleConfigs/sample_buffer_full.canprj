; Frame buffer check (feature 008, domain spec 3.7a).
; ECU1 raises 20 requests at the same instant every 100 ms (offset 0, same
; period): 16 transmit buffers take the 16 lowest IDs (0x100..0x10F) and the
; 4 highest (0x110..0x113) are dropped as OVERWRITE -> 100 x 4 = 400 in 10 s.
; ECU2 has a receive delay of 2 ms, so the burst of ECU1 frames overflows its
; 8 receive buffers (receive-side OVERWRITE). ECU3 sends a short frame every
; 1 ms as background traffic.

[Project]
EcuCount=3
DurationSec=10
FrameDisplay=0
Speed=10

[Network]
BitRateBps=500000

[Node1]
NodeId=1
Name=ECU1 Burst Sender

