; Late-join verification configuration (feature 002, quickstart.md step 4).
; Node 1 transmits continuously; nodes 2 and 3 have no frames of their own and
; only join the running bus.
;   Node 1: Normal at 22 us, first frame 22 -> 274 us, intermission ends 280 us.
;   Node 2: detection starts at 100 us, i.e. during node 1's frame
;           -> expected Normal_Entry_us = 280 (US3 AS#1 / SC-004).
;   Node 3: detection starts at 290 us while the bus is idle, but node 1 starts
;           transmitting again at 300 us before 11 recessive bit times elapse
;           -> the count restarts and Normal_Entry_us becomes 558
;           (= 552 + 6, the intermission end of that second frame; US3 AS#2 / FR-007).

[Project]
EcuCount=3
DurationSec=10
FrameDisplay=0

[Network]
BitRateBps=500000

[Node1]
NodeId=1
Name=ECU1 Continuous Sender
PowerOnTimeUs=0
InitDurationUs=0

[Node1.Frame1]
CanId=0x100
Dlc=8
Data=00,00,00,00,00,00,00,00
PeriodUs=300
InitialOffsetUs=0

[Node2]
NodeId=2
Name=ECU2 Joins During Frame
PowerOnTimeUs=100
InitDurationUs=0

[Node3]
NodeId=3
Name=ECU3 Joins Just Before Frame
PowerOnTimeUs=290
InitDurationUs=0
