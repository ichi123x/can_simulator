; 16 ECU sample project (feature 004). Every ECU sends one 8-byte frame every
; 20 ms; the CAN ID decreases with the ECU number so that ECU 16 has the
; highest priority. Used to check the 16 ECU diagram and the frame display.

[Project]
EcuCount=16
DurationSec=10
FrameDisplay=0

[Network]
BitRateBps=500000

[Node1]
NodeId=1
Name=ECU1

[Node1.Frame1]
CanId=0x2F0
Dlc=8
PeriodUs=20000
InitialOffsetUs=0

[Node2]
NodeId=2
Name=ECU2

[Node2.Frame1]
CanId=0x2E0
Dlc=8
PeriodUs=20000
InitialOffsetUs=1000

